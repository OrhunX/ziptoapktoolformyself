<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Spotify / YouTube lookups and the in-app YouTube player -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Our own player: playback notification and media foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lock-screen player and cross-app playlists: lets the hub show its player over the
         lock screen and open Spotify / YouTube Music for the next song while in the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Visualizer: the Visualizer API requires RECORD_AUDIO; the output mix (session 0)
         also needs MODIFY_AUDIO_SETTINGS. Audio is analysed in memory only, never stored.
         FOREGROUND_SERVICE_MICROPHONE keeps the analysis alive for the home-screen widget. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Library: the phone's own music files -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.software.app_widgets"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Package visibility (Android 11+): apps we label, launch or deep-link into -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <!-- Waking a closed player in the background through its media browser service -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".UltimateApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UltimateWidget">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Playlist share links and QR codes: umw://import?c=UMW1-... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="umw" android:host="import" />
            </intent-filter>
        </activity>

        <!-- Full-screen player shown over the lock screen; minimizes to the small media card -->
        <activity
            android:name=".ui.LockPlayerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="com.sen0413.ultimatewidget.lockplayer" />

        <!-- Google's sign-in page for YouTube Music (private playlist import) -->
        <activity
            android:name=".ui.YouTubeLoginActivity"
            android:exported="false"
            android:label="@string/setup_youtube" />

        <!-- Widget editor: opens when the widget is added and again via long-press (reconfigurable) -->
        <activity
            android:name=".ui.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/editor_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.HubWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hub_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MiniWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_mini">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hub_widget_mini" />
        </receiver>
        <receiver
            android:name=".widget.SmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hub_widget_small" />
        </receiver>
        <receiver
            android:name=".widget.SquareWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hub_widget_square" />
        </receiver>
        <receiver
            android:name=".widget.SlimWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_slim">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hub_widget_slim" />
        </receiver>
        <receiver
            android:name=".widget.LargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hub_widget_large" />
        </receiver>

        <!-- Collection widget: feeds the "Up next" ListView -->
        <service
            android:name=".widget.QueueWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Our own player: Media3 MediaSessionService -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Keeps a YouTube song playing inside the app (embedded player) alive in the background -->
        <service
            android:name=".hub.YouTubeEmbedService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps real-audio analysis running for the widget while music plays -->
        <service
            android:name=".visualizer.VisualizerService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Notification access lets the hub read and control other players' MediaSessions
             (Spotify, YouTube Music, ...). We never read notification content. -->
        <service
            android:name=".playback.MediaListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
