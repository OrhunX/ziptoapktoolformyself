<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/cd_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/cover_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/source_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_local"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:minHeight="20dp"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="2dp"
                    android:text="@string/source_local"
                    android:textColor="#FF15131D"
                    android:textSize="11sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/video_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_video"
                    android:contentDescription="@string/cd_video"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:minHeight="20dp"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="2dp"
                    android:text="@string/video_chip"
                    android:textColor="#FF15131D"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/btn_fav"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/cd_favorite_add"
                    android:padding="5dp"
                    android:src="@drawable/ic_heart_outline" />
            </LinearLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk_bold"
                android:maxLines="1"
                android:text="@string/preview_title"
                android:textColor="#FFF4F1EC"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_idle_artist"
                    android:textColor="#FFC9C3D9"
                    android:textSize="12sp" />

                <Chronometer
                    android:id="@+id/elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#FFC9C3D9"
                    android:textSize="12sp" />
            </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_shuffle"
                android:layout_width="38dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_shuffle"
                android:padding="6dp"
                android:src="@drawable/ic_shuffle" />

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_previous"
                android:padding="6dp"
                android:src="@drawable/ic_prev" />

            <FrameLayout
                android:id="@+id/play_box"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_play">

                <ImageView
                    android:id="@+id/play_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/play_circle" />

                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_next"
                android:padding="6dp"
                android:src="@drawable/ic_next" />

            <ImageView
                android:id="@+id/btn_repeat"
                android:layout_width="38dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_repeat_all"
                android:padding="6dp"
                android:src="@drawable/ic_repeat" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <LinearLayout
                    android:id="@+id/bars"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="horizontal">
                <ProgressBar
                    android:id="@+id/bar0"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="380"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="620"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="500"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="860"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar4"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="580"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar5"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="940"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar6"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="450"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar7"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="760"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar8"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="540"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar9"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="900"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar10"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="420"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar11"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="680"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar12"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="330"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar13"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="560"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar14"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="300"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar15"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="460"
                    android:progressDrawable="@drawable/bar_progress" />
                </LinearLayout>

                <TextView
                    android:id="@+id/vis_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/vis_needs_permission"
                    android:textColor="#FFF4F1EC"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/queue_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/up_next"
            android:textColor="#FFC4A8FF"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/queue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp" />

            <TextView
                android:id="@+id/queue_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/queue_empty"
                android:textColor="#FFC9C3D9"
                android:textSize="12sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
