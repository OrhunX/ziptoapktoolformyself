                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="460"
                    android:progressDrawable="@drawable/bar_progress" />
                </LinearLayout>

                <TextView
                    android:id="@+id/vis_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/vis_needs_permission"
                    android:textColor="#FFF4F1EC"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_previous"
                android:padding="6dp"
                android:src="@drawable/ic_prev" />

            <FrameLayout
                android:id="@+id/play_box"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cd_play">

                <ImageView
                    android:id="@+id/play_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/play_circle" />

                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_next"
                android:padding="6dp"
                android:src="@drawable/ic_next" />

        <ImageView
            android:id="@+id/btn_fav"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/cd_favorite_add"
            android:padding="6dp"
            android:src="@drawable/ic_heart_outline" />
    </LinearLayout>
</FrameLayout>
