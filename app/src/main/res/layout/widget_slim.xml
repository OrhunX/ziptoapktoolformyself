                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="540"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar9"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="900"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar10"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="420"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar11"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="1.5dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="400dp"
                    android:minHeight="2dp"
                    android:progress="680"
                    android:progressDrawable="@drawable/bar_progress" />
                <ProgressBar
                    android:id="@+id/bar12"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
