<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Screens are drawn by our own views; the window theme only provides a matching,
         edge-to-edge dark canvas. -->
    <style name="Theme.UltimateWidget" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorAccent">@color/lavender</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
