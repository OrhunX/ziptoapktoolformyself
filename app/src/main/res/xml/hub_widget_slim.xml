<?xml version="1.0" encoding="utf-8"?>
<!-- Listed in the launcher as its own entry and placed at 4×1; still resizable to any size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.sen0413.ultimatewidget.ui.WidgetConfigActivity"
    android:description="@string/widget_description_slim"
    android:initialLayout="@layout/widget_slim"
    android:maxResizeHeight="460dp"
    android:maxResizeWidth="560dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_slim"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
